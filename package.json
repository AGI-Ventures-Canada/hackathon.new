{
  "name": "hackathon.new",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Open-source platform for running hackathons",
  "private": true,
  "homepage": "https://hackathon.new",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGI-Ventures-Canada/hackathon.new.git"
  },
  "bugs": {
    "url": "https://github.com/AGI-Ventures-Canada/hackathon.new/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "predev": "./scripts/setup-local-db.sh",
    "dev": "next dev",
    "dev:fresh": "./scripts/setup-local-db.sh && supabase db reset && bun run dev:skip-setup",
    "dev:skip-setup": "next dev",
    "build": "bun run check:production-email-delivery && next build && bun run check:sharp-trace",
    "docs:generate": "fumadocs-mdx",
    "check:production-email-delivery": "bun run scripts/check-production-email-delivery.ts",
    "check:sharp-trace": "bun run scripts/check-sharp-trace.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "bun scripts/run-unit-tests.ts",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:email": "bun test --test-name-pattern '.*' __tests__/integration/*.email.test.ts __tests__/lib/email-templates.test.ts",
    "test:all": "bun run test && bun run test:integration && bun run test:email && bun run cli:test",
    "db:sync": "supabase db reset && supabase gen types typescript --local > lib/db/types.ts",
    "db:diff": "supabase db diff -f",
    "update-types": "supabase gen types typescript --local > lib/db/types.ts",
    "update-types:remote": "supabase gen types typescript --project-id \"$PROJECT_REF\" > lib/db/types.ts",
    "gen:secret": "openssl rand -hex 32",
    "cli": "bun run packages/cli/src/cli.ts",
    "cli:test": "bun test packages/cli/__tests__",
    "cli:build": "cd packages/cli && bun run build",
    "email:dev": "email dev --dir emails --port 3001",
    "browser": "./scripts/browser.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.118",
    "@base-ui/react": "1.8.0",
    "@clerk/nextjs": "^6.39.6",
    "@clerk/themes": "^2.4.63",
    "@daytonaio/sdk": "^0.130.0",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/swagger": "^1.3.1",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tavily/core": "^0.7.12",
    "@vercel/functions": "3.9.8",
    "@workflow/ai": "^4.2.1",
    "@xyflow/react": "^12.11.6",
    "ai": "6.0.283",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.10.1",
    "date-fns": "4.4.0",
    "elysia": "^1.4.30",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-ui": "^16.15.11",
    "jszip": "^3.10.2",
    "lucide-react": "^0.562.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.433.6",
    "posthog-node": "^5.52.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "resend": "^6.28.1",
    "shadcn": "^3.8.5",
    "sharp": "0.35.4",
    "shiki": "^3.23.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.1",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "workflow": "^4.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "happy-dom": "20.14.5",
    "react-email": "^5.2.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@xhmikosr/decompress": "11.1.4",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/core": "2.11.0",
    "axios": "1.20.0",
    "defu": "6.1.7",
    "dompurify": "3.4.15",
    "engine.io": "6.6.10",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "fast-uri": "3.1.8",
    "fast-xml-parser": "5.11.1",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.13.8",
    "js-yaml": "4.3.2",
    "next": "16.3.5",
    "nanoid": "5.1.16",
    "postcss": "8.5.28",
    "protobufjs": "7.6.6",
    "qs": "6.16.0",
    "shell-quote": "1.10.0",
    "sharp": "0.35.4",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "undici": "7.29.1",
    "ws": "8.21.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
