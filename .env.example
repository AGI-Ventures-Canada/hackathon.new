# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-your-clerk-webhook-signing-secret

# Local application secrets
API_KEY_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=replace-with-a-random-secret

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email delivery
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
RESEND_REPLY_TO_EMAIL=support@example.com
RESEND_REQUEST_TIMEOUT_MS=10000
RESEND_WEBHOOK_SECRET=replace-with-your-resend-webhook-secret

# Optional integrations
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional exact-origin WebMCP token; sent only as a matching-host response header
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Local Supabase values are written by `bun dev`
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional local test-scenario identities
SCENARIO_ORG_ID=
SCENARIO_DEV_USER_ID=
SCENARIO_DEV_USER_EMAIL=
